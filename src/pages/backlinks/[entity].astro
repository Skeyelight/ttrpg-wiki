---
import { getCollection, type CollectionEntry } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

interface LinkedPage {
  title: string;
  slug: string;
}

interface BacklinkData {
  displayName: string;
  linkedPages: LinkedPage[];
}

export async function getStaticPaths() {
  const docs: CollectionEntry<'docs'>[] = await getCollection('docs');

  // Map to hold entity -> list of matching pages
  const backlinksMap = new Map<string, BacklinkData>();

  docs.forEach((doc: CollectionEntry<'docs'>) => {
    // Fallback to empty string if doc.body is undefined or empty
    const bodyText = doc.body || '';
    const matches = bodyText.matchAll(/\[\[([^\]|]+)(?:\|[^\]]+)?\]\]/g);

    for (const match of matches) {
      const rawTarget = match[1].trim();
      // Extract entity name from path (e.g. "Party/Rathgar" -> "rathgar")
      const entitySlug = rawTarget.split('/').pop()?.toLowerCase().replace(/ /g, '-') || '';

      if (!entitySlug) continue;

      if (!backlinksMap.has(entitySlug)) {
        backlinksMap.set(entitySlug, {
          displayName: rawTarget.split('/').pop() || entitySlug,
          linkedPages: [],
        });
      }

      const entry = backlinksMap.get(entitySlug);
      if (entry && !entry.linkedPages.some((p: LinkedPage) => p.slug === doc.slug)) {
        entry.linkedPages.push({
          title: doc.data.title || doc.id,
          slug: doc.slug,
        });
      }
    }
  });

  return Array.from(backlinksMap.entries()).map(([slug, data]) => ({
    params: { entity: slug },
    props: {
      displayName: data.displayName,
      pages: data.linkedPages,
    },
  }));
}

const { displayName, pages } = Astro.props as { displayName: string; pages: LinkedPage[] };
---

<StarlightPage frontmatter={{ title: `Mentions of ${displayName}` }}>
  <p>Below is every page and recap referencing <strong>{displayName}</strong>:</p>

  <ul>
    {pages.map((page: LinkedPage) => (
      <li>
        <a href={`/${page.slug}`}>{page.title}</a>
      </li>
    ))}
  </ul>
</StarlightPage>