---
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

export async function getStaticPaths() {
  const docs = await getCollection('docs');

  // Map to hold entity -> list of matching pages
  const backlinksMap = new Map();

  docs.forEach((doc) => {
    // Scan raw body text for wikilink patterns like [[Rathgar]], [[Party/Rathgar]], or [[Party/Rathgar|Rathgar]]
    const matches = doc.body.matchAll(/\[\[([^\]|]+)(?:\|[^\]]+)?\]\]/g);

    for (const match of matches) {
      const rawTarget = match[1].trim();
      // Extract entity name from path (e.g. "Party/Rathgar" -> "rathgar")
      const entitySlug = rawTarget.split('/').pop().toLowerCase().replace(/ /g, '-');

      if (!backlinksMap.has(entitySlug)) {
        backlinksMap.set(entitySlug, {
          displayName: rawTarget.split('/').pop(),
          linkedPages: [],
        });
      }

      const existingPages = backlinksMap.get(entitySlug).linkedPages;
      if (!existingPages.some((p) => p.id === doc.id)) {
        existingPages.push({
          title: doc.data.title || doc.id,
          slug: doc.slug,
        });
      }
    }
  });

  return Array.from(backlinksMap.entries()).map(([slug, data]) => ({
    params: { entity: slug },
    props: {
      displayName: data.displayName,
      pages: data.linkedPages,
    },
  }));
}

const { entity } = Astro.params;
const { displayName, pages } = Astro.props;
---

<StarlightPage frontmatter={{ title: `Mentions of ${displayName}` }}>
  <p>Below is every page and recap referencing <strong>{displayName}</strong>:</p>

  <ul>
    {pages.map((page) => (
      <li>
        <a href={`/${page.slug}`}>{page.title}</a>
      </li>
    ))}
  </ul>
</StarlightPage>